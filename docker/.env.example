# Copy to .env at the repository root (docker compose reads it from there).
# An auth key from https://login.tailscale.com/admin/settings/keys (reusable, and tagged if your ACL uses tags).
TS_AUTHKEY=
# The machine name on the tailnet: the UI is then https://groundwork-dev.<your-tailnet>.ts.net
TS_HOSTNAME=groundwork-dev
# Extra flags for python -m studio_api: --fake serves FakeServices instead of this checkout's workspace; --allow-cpu trains on the CPU.
API_ARGS=
