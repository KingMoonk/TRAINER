          "stop": {
            "title": "Stop"
          },
          "trainer": {
            "default": "",
            "title": "Trainer",
            "type": "string"
          },
          "watchdog": {
            "default": "",
            "title": "Watchdog",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "PassiveSession",
        "type": "object"
      },
      "PassiveStatus": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "PassiveStatus",
        "type": "object"
      },
      "PretrainedImport": {
        "properties": {
          "name": {
            "default": "gpt2",
