            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "fraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fraction"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "progress": {
            "default": "",
            "title": "Progress",
            "type": "string"
          },
          "result": {
            "title": "Result"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "created_at"
        ],
        "title": "JobOut",
        "type": "object"
      },
      "NewVersion": {
        "properties": {
          "change": {
            "default": "",
            "title": "Change",
            "type": "string"
          },
          "prediction": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "the guess made on saving, e.g. {\"error\": \"lower\"}",
            "title": "Prediction"
          },
          "spec": {
            "additionalProperties": true,
            "title": "Spec",
            "type": "object"
          }
        },
        "required": [
          "spec"
        ],
        "title": "NewVersion",
        "type": "object"
      },
      "Node": {
        "properties": {
          "busy": {
            "title": "Busy",
            "type": "boolean"
          },
          "device": {
