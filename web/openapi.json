            "type": "boolean"
          },
          "days": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "delete runs older than this many days; null = all history",
            "title": "Days"
          }
