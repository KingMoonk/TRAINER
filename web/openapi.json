          },
          "change": {
            "default": "",
            "title": "Change",
            "type": "string"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "parent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent"
          },
          "prediction": {
            "additionalProperties": true,
            "title": "Prediction",
            "type": "object"
          },
          "scorecard": {
            "additionalProperties": true,
            "title": "Scorecard",
            "type": "object"
          },
          "spec": {
            "additionalProperties": true,
            "title": "Spec",
            "type": "object"
          },
          "status": {
            "default": "draft",
            "title": "Status",
            "type": "string"
          },
          "verdict": {
            "default": "",
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "number"
        ],
        "title": "Version",
        "type": "object"
      }
    }
