// The strings the Chat page shows, moved from the CHAT table in studio_ia/copy.py (which stays while the Tk page uses it).
export const CHAT = {
  noTrained: "No trained version yet.",
  noTrainedLink: "Train one from Build your model.",
  follows: "follows the best checkpoint",
  picked: "picked by you",
  compareBtn: "Compare two versions",
  backToOne: "Back to one version",
  itsReply: "Its reply appears here.",
  teachCorrection: "Teach a correction",
  teachCorrectionDesc: "Saved for Post-training round 3: the teacher is this same model shown your correction as a hint.",
  wholeAnswer: "It is a whole new answer (round 1)",
  thisOneBetter: "This one is better",
  pickingReplyDesc: "Picking a reply saves a rated pair for Post-training round 4. It changes nothing until that round is trained.",
  verdict: "The verdict",
  howMeasured: "How this is measured",
  hideHowMeasured: "Hide how this is measured",
  verdictText:
    "Take the newer version's error on held-back text. Find how much training the older one needed to reach that same error. The gap is the saving. Read off the two error-versus-compute curves; no new runs. Only runs trained to the same length on the same schedule are compared; otherwise there is no verdict.",
  verdictErrorUnit:
    "Error is measured per character, not per word piece, so versions with different word lists can be compared fairly. The held-back text is never used for training.",
  send: "Send",
  stop: "Stop",
  versions: "Versions",
  shelfHintCompare: "Pick the version for the right-hand reply.",
  shelfHintSingle: "Chat follows the best checkpoint unless you pick one. Switching is live; nothing retrains.",
  placeholderCompare: "Ask both versions the same thing",
  placeholderSingle: "Type a message",
  testChange: "Test this change properly",
  openDesigner: "Open in designer",
  noVerdictYet: (version: string) => `No verdict yet: ${version} hasn't finished its schedule.`,
  noVerdictText:
    "Error mid-schedule looks worse than it will after the cool-down, so only runs trained to the same length on the same schedule are compared. Its replies are still worth reading.",
  verdictLine: (newer: string, older: string, percent: number) =>
    `To reach the same error, ${newer} needs ${percent.toFixed(0)}% of the training ${older} needed.`,
  verdictSub: "Under 100% means the change saves training. Same length and schedule · error per character on held-back text",
  errorHeldBack: "Error on held-back text",
  answersPrompts: "Answers prompts",
  checkedProblems: "Checked problems passed",
  judgePreferred: "Judge preferred it over previous",
  sizeSpeed: "Size · speed",
  valBpc: "not measured yet",
  valKofn: "not checked yet",
  valSizeSpeed: "not measured yet",
  best: (number: number) => `Version ${number} is best`,
  findingBest: "Finding the best checkpoint…",
  noBest: "No best checkpoint is available. Pick a trained version to chat.",
  retryBest: "Check best again",
  bestFailed: "Could not check the best version",
  bestChanged: "The trained versions changed while checking the best. Check best again.",
  invalidBest: "The server returned an invalid best-version result.",
  invalidStep: "The server returned an invalid checkpoint step.",
  invalidFewShot: "The server returned an invalid example-check result.",
  checkpoint: (step: number) => `checkpoint at step ${step.toLocaleString()}`,
  checkpointLoading: "Reading checkpoint step…",
  checkpointUnknown: "Checkpoint step not recorded",
  checkpointFailed: "Could not read the checkpoint step",
  retryStep: "Retry checkpoint step",
  fewShot: "Learning from examples in the question",
  fewShotHint: "Multiple-choice questions from your checked problems, asked three ways: on their own, with one solved example written in front, then with a few. Nothing is trained. The version picks the option it finds most likely, so this shows how much it learns from examples alone.",
  fewShotRun: "Check it",
  fewShotAgain: "Check again",
  fewShotRunning: "Asking the multiple-choice questions",
  fewShotNotRun: "Not checked yet for this version. It can take a few minutes.",
  fewShotNone: "No multiple-choice problems yet. Add a set with lettered options, such as ARC or HellaSwag, in Your data.",
  fewShotHead: ["Solved examples shown", "Right", "Score", "Guessing gets", "Against guessing"],
  fewShotZero: "none",
  fewShotOne: "one",
  fewShotFitted: (used: string) => ` (${used} fit on average)`,
  fewShotAbove: "better",
  fewShotNear: "about the same",
  fewShotBelow: "worse",
  fewShotAsked: (items: number, tasks: number) => `${items} questions from ${tasks} kinds of problem.`,
  fewShotTraining: "There are no held-back multiple-choice problems yet, so these come from the ones used for training.",
  fewShotChance: (percent: string) => `Picking at random gets about ${percent}% right. A small model usually scores close to that; only a clear gap above it means it learned something.`,
  fewShotChanceUnknown: "The guessing score was not measured.",
  fewShotCancelled: "Example check cancelled.",
  cancelCheck: "Cancel check",
  notMeasured: "not measured",
} as const;
