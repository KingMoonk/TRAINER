# The version bucket's settings (docs/cluster.md, "The version bucket"). Nothing here is a secret until you fill it in.
#
# Copy this file to ~/.config/trainer/store.env (outside the repository), fill in the values, and load it from your shell profile:
#
#     [ -f ~/.config/trainer/store.env ] && . ~/.config/trainer/store.env
#
# Then check the connection:
#
#     python -m studio_publish --check            # lists the bucket: objects, bytes used, limit, room left
#     python -m studio_publish --check --write    # also writes, reads back and deletes a small test object
#
# Never commit the filled-in file. If the secret leaks, delete the token in the Cloudflare dashboard and make a new one.

# The R2 S3 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (R2 overview page, under Account Details).
# A bucket made in a jurisdiction uses <ACCOUNT_ID>.eu.r2.cloudflarestorage.com and the like.
# export TRAINER_STORE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# The bucket name.
# export TRAINER_STORE_BUCKET=trainer-versions

# From an R2 API token with Object Read & Write on that one bucket. The secret is shown once, when the token is made.
# export TRAINER_STORE_KEY_ID=
# export TRAINER_STORE_SECRET=

# Optional: a folder inside the bucket. Leave it out to use the top of the bucket.
# export TRAINER_STORE_PREFIX=trainer

# Optional: leave unset for R2 (it uses "auto").
# export TRAINER_STORE_REGION=

# Optional: the most the whole bucket may hold, in GB. The default is 9.5, half a GB under R2's 10 GB free storage, for headroom. The
# maximum is 10: an upload that would pass the limit is refused. This cannot raise the limit past 10; a higher value makes every upload
# fail with a message naming the setting. Unfinished multipart uploads count too (docs/cluster.md, "Unfinished multipart uploads count").
# export TRAINER_STORE_LIMIT_GB=9.5
